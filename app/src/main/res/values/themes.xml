<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DEmo1" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#E53935</item>
        <item name="colorPrimaryDark">#B71C1C</item>
        <item name="colorAccent">#E53935</item>
        <item name="android:windowBackground">#121212</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="materialAlertDialogTheme">@style/RoundedAlertDialog</item>
    </style>

    <style name="RoundedAlertDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="shapeAppearanceOverlay">@style/DialogCorners</item>
        <item name="buttonBarPositiveButtonStyle">@style/AlertButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertButton.Negative</item>
    </style>

    <style name="DialogCorners" parent="">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="AlertButton.Positive" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">#4CAF50</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="AlertButton.Negative" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#FF9800</item>
        <item name="rippleColor">#22FF9800</item>
    </style>
</resources>